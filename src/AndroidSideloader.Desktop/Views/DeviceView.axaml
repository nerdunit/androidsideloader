<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AndroidSideloader.Desktop.Views.DeviceView">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8">
            <Button Content="Refresh"
                    Command="{Binding RefreshDeviceInfoCommand}"
                    IsEnabled="{Binding !IsLoading}"/>
            <Button Content="Reset ADB Auth"
                    Command="{Binding ResetAdbAuthCommand}"
                    IsEnabled="{Binding !IsLoading}"/>
            <Button Content="Reboot Device"
                    Command="{Binding RebootDeviceCommand}"
                    IsEnabled="{Binding !IsLoading}"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Storage:" FontWeight="Bold" Margin="8,8,8,0" Foreground="#ccc"/>
        <TextBlock Grid.Row="2" Text="{Binding StorageInfo}" Margin="8,0,8,8" Foreground="#aaa" TextWrapping="Wrap"/>

        <Border Grid.Row="3" Background="#1a1a1a" Margin="8" CornerRadius="4">
            <ScrollViewer>
                <TextBlock Text="{Binding DeviceInfo}"
                           FontFamily="Consolas, monospace"
                           Foreground="#aaa"
                           TextWrapping="Wrap"
                           Margin="8"/>
            </ScrollViewer>
        </Border>
    </Grid>

</UserControl>
