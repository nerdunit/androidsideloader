<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" Height="400"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#181d24"
        Title="ADB Command"
        x:Class="AndroidSideloader.Desktop.Views.AdbCommandDialog">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="12">
        <TextBlock Grid.Row="0" Text="Enter ADB command:" Foreground="White" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" Text="{Binding CommandText, Mode=TwoWay}" Watermark="e.g. shell pm list packages"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 Background="#1e232a" Foreground="White" CaretBrush="White"
                 BorderBrush="#333" BorderThickness="1" Padding="8" FontFamily="Consolas, monospace"/>

        <TextBlock Grid.Row="2" Text="Output:" Foreground="#ccc" Margin="0,8,0,4"/>
        <Border Grid.Row="3" Background="#1a1a1a" CornerRadius="4">
            <ScrollViewer>
                <TextBlock Text="{Binding OutputText}"
                           Foreground="#aaa"
                           TextWrapping="Wrap"
                           FontFamily="Consolas, monospace"
                           Margin="8"/>
            </ScrollViewer>
        </Border>
    </Grid>

    <Window.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding ExecuteCommand}"/>
    </Window.KeyBindings>

</Window>
