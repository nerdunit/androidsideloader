<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AndroidSideloader.Desktop.Views.QueueView">

    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8">
            <Button Content="Start Queue" Command="{Binding StartQueueCommand}" IsEnabled="{Binding !IsRunning}"/>
            <Button Content="Cancel" Command="{Binding CancelQueueCommand}" IsEnabled="{Binding IsRunning}"/>
            <Button Content="Clear Completed" Command="{Binding ClearCompletedCommand}"/>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#888"/>
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Items}" Margin="8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding GameName}" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ReleaseName}" Foreground="#888" FontSize="11"/>
                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4"
                                         IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SizeMB, StringFormat='{}{0:F0} MB'}" Foreground="#aaa" Margin="8,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#52cbaa" Margin="8,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding ErrorMessage}" Foreground="#f52f57"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="8,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>

</UserControl>
